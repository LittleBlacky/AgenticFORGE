# =========================
# LLM 配置（必填）
# 支持 OpenAI 兼容接口，如 DashScope、DeepSeek、Ollama 等
# =========================
LLM_API_KEY="your-api-key"
LLM_MODEL_ID="qwen-plus"
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_TIMEOUT="60"

# =========================
# Embedding 配置（必填，用于向量化存储与检索）
# 使用与 LLM 相同接口的 embedding 模型
# =========================
EMBEDDING_API_KEY="your-api-key"
EMBEDDING_MODEL_ID="text-embedding-v4"
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_TIMEOUT="60"

# =========================
# 搜索引擎（可选，用于 deep-research skill）
# 三选一即可，优先级：TAVILY > SERPAPI
# =========================
SERPAPI_API_KEY=""
TAVILY_API_KEY=""
PERPLEXITY_API_KEY=""

# =========================
# Qdrant 向量库（推荐）
# 未填写 QDRANT_URL 时自动退回到 InMemoryVectorStore
# Docker 快速启动：docker run -p 6333:6333 qdrant/qdrant
# =========================
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="second_brain_vectors"

# =========================
# Neo4j 图数据库（推荐）
# 未填写 NEO4J_URI 时图谱功能自动禁用
# Docker 快速启动：docker run -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5
# =========================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE=""

# =========================
# 服务端口（可选）
# =========================
PORT=3010
