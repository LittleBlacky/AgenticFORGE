{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@AgenticKIT/core": ["packages/core/src"],
      "@AgenticKIT/context": ["packages/context/src"],
      "@AgenticKIT/tools": ["packages/tools/src"],
      "@AgenticKIT/tools-builtin": ["packages/tools-builtin/src"],
      "@AgenticKIT/memory": ["packages/memory/src"],
      "@AgenticKIT/utils": ["packages/utils/src"],
      "@AgenticKIT/agents": ["packages/agents/src"],
      "@AgenticKIT/kit": ["packages/kit/src"]
    },
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["packages/*/src/**/*.ts", "examples/SimpleAgent.example.ts"],
  "exclude": ["node_modules", "dist", "examples"]
}

