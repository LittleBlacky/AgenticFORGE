{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@agenticforge/core": ["packages/core/src"],
      "@agenticforge/context": ["packages/context/src"],
      "@agenticforge/tools": ["packages/tools/src"],
      "@agenticforge/tools-builtin": ["packages/tools-builtin/src"],
      "@agenticforge/memory": ["packages/memory/src"],
      "@agenticforge/utils": ["packages/utils/src"],
      "@agenticforge/agents": ["packages/agents/src"],
      "@agenticforge/workflow": ["packages/workflow/src"],
      "@agenticforge/kit": ["packages/kit/src"],
      "@agenticforge/skills": ["packages/skills/src"],
      "@agenticforge/protocols": ["packages/protocols/src"]
    },
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/backend/src/**/*.ts", "apps/*/frontend/src/**/*.ts", "examples/SimpleAgent.example.ts"],
  "exclude": ["node_modules", "dist", "examples"]
}
