{
  "name": "@agenticforge/tools",
  "version": "1.1.7",
  "description": "Tooling core for AgenticFORGE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "rollup -c",
    "build": "pnpm run clean && pnpm run typecheck && pnpm run build:types && pnpm run build:js"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^25.6.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleBlacky/AgenticFORGE.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/LittleBlacky/AgenticFORGE/tree/main/packages/tools#readme",
  "bugs": {
    "url": "https://github.com/LittleBlacky/AgenticFORGE/issues"
  },
  "license": "CC-BY-NC-SA-4.0",
  "keywords": [
    "agenticforge",
    "agent",
    "ai",
    "llm",
    "typescript",
    "tool",
    "tool-registry",
    "tool-chain",
    "function-calling",
    "zod"
  ]
}
