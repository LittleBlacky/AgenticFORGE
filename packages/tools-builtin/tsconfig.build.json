{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/types",
    "paths": {
      "@agenticforge/core": ["../core/dist/types"],
      "@agenticforge/tools": ["../tools/dist/types"],
      "@agenticforge/memory": ["../memory/dist/types"]
    }
  },
  "include": ["src/**/*.ts"]
}
