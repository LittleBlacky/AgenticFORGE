{
  "name": "@agenticforge/agents",
  "version": "1.3.4",
  "description": "Agent implementations for AgenticFORGE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "rollup -c",
    "build": "pnpm run clean && pnpm run typecheck && pnpm run build:types && pnpm run build:js"
  },
  "dependencies": {
    "@agenticforge/core": "workspace:^",
    "@agenticforge/context": "workspace:^",
    "@agenticforge/tools": "workspace:^",
    "@agenticforge/tools-builtin": "workspace:^",
    "@agenticforge/memory": "workspace:^",
    "@agenticforge/skills": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^25.3.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.59.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LittleBlacky/AgenticFORGE.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/LittleBlacky/AgenticFORGE/tree/main/packages/agents#readme",
  "bugs": {
    "url": "https://github.com/LittleBlacky/AgenticFORGE/issues"
  },
  "license": "CC-BY-NC-SA-4.0",
  "keywords": [
    "agenticforge",
    "agent",
    "ai",
    "llm",
    "typescript",
    "react-agent",
    "plan-solve",
    "reflection",
    "function-call-agent",
    "simple-agent",
    "agent-workflow"
  ]
}
