{
  "name": "@agenticforge/workflow",
  "version": "1.0.1",
  "description": "DAG workflow engine for AgenticFORGE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "rollup -c",
    "build": "pnpm run clean && pnpm run typecheck && pnpm run build:types && pnpm run build:js"
  },
  "dependencies": {
    "@agenticforge/core": "workspace:^",
    "@agenticforge/tools": "workspace:^"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^25.8.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.22.1",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LittleBlacky/AgenticFORGE.git",
    "directory": "packages/workflow"
  },
  "homepage": "https://github.com/LittleBlacky/AgenticFORGE/tree/main/packages/workflow#readme",
  "bugs": {
    "url": "https://github.com/LittleBlacky/AgenticFORGE/issues"
  },
  "license": "CC-BY-NC-SA-4.0",
  "keywords": [
    "agenticforge",
    "workflow",
    "dag",
    "agent",
    "ai",
    "llm",
    "typescript",
    "orchestration",
    "pipeline"
  ]
}
