{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "noEmit": true,
    "outDir": "dist/types",
    "baseUrl": ".",
    "paths": {
      "@agenticforge/core": ["../core/src"],
      "@agenticforge/tools": ["../tools/src"],
      "@agenticforge/utils": ["../utils/src"]
    }
  },
  "include": ["src/**/*.ts"]
}
