{
  "name": "@agenticforge/memory",
  "version": "1.1.6",
  "description": "Memory and RAG layer for AgenticFORGE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./manager": {
      "types": "./dist/types/manager.d.ts",
      "import": "./dist/esm/manager.js",
      "require": "./dist/cjs/manager.cjs"
    },
    "./rag": {
      "types": "./dist/types/rag/index.d.ts",
      "import": "./dist/esm/rag.js",
      "require": "./dist/cjs/rag.cjs"
    },
    "./storage": {
      "types": "./dist/types/storage/index.d.ts",
      "import": "./dist/esm/storage.js",
      "require": "./dist/cjs/storage.cjs"
    },
    "./embedding": {
      "types": "./dist/types/embedding/index.d.ts",
      "import": "./dist/esm/embedding.js",
      "require": "./dist/cjs/embedding.cjs"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "import": "./dist/esm/types.js",
      "require": "./dist/cjs/types.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "rollup -c",
    "build": "pnpm run clean && pnpm run typecheck && pnpm run build:types && pnpm run build:js"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.17.0",
    "neo4j-driver": "^5.28.1",
    "openai": "^6.34.0",
    "@agenticforge/core": "workspace:^"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^25.3.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.59.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LittleBlacky/AgenticFORGE.git",
    "directory": "packages/memory"
  },
  "homepage": "https://github.com/LittleBlacky/AgenticFORGE/tree/main/packages/memory#readme",
  "bugs": {
    "url": "https://github.com/LittleBlacky/AgenticFORGE/issues"
  },
  "license": "CC-BY-NC-SA-4.0",
  "keywords": [
    "agenticforge",
    "agent",
    "ai",
    "llm",
    "typescript",
    "memory",
    "rag",
    "vector-store",
    "episodic-memory",
    "semantic-memory",
    "qdrant",
    "neo4j"
  ]
}
