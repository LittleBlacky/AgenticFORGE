# =========================
# LLM（可选）
# 仅在你使用 MQE/HyDE/总结等 LLM 能力时需要
# =========================
LLM_API_KEY=""
LLM_MODEL_ID=""
LLM_BASE_URL=""
LLM_TIMEOUT="60"

# =========================
# Embedding（可选）
# 不填则使用内置 HashTextEmbedder（可用于 smoke test）
# =========================
EMBEDDING_API_KEY=""
EMBEDDING_MODEL_ID=""
EMBEDDING_BASE_URL=""
EMBEDDING_TIMEOUT="60"

# =========================
# Qdrant（向量库，可选）
# 若启用 Memory 向量存储，请配置以下参数
# =========================
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="agentic_kit_vectors"

# =========================
# Neo4j（图数据库，可选）
# 若启用 Memory 图谱存储，请配置以下参数
# =========================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE=""

# =========================
# Local Blob（本地文件存储，可选）
# 若启用 Memory 感知数据存储，请配置以下参数
# =========================
BLOB_STORAGE_PATH="./memory_blobs"

# =========================
# RAG 业务命名空间（可选）
# =========================
RAG_NAMESPACE="default"
