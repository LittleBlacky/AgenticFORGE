{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@agenticforge/core": ["packages/core/src"],
      "@agenticforge/tools": ["packages/tools/src"],
      "@agenticforge/context": ["packages/context/src"],
      "@agenticforge/memory": ["packages/memory/src"],
      "@agenticforge/agents": ["packages/agents/src"],
      "@agenticforge/skills": ["packages/skills/src"],
      "@agenticforge/utils": ["packages/utils/src"],
      "@agenticforge/kit": ["packages/kit/src"],
      "@agenticforge/protocols": ["packages/protocols/src"],
      "@agenticforge/tools-builtin": ["packages/tools-builtin/src"]
    },
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps",
    "examples"
  ]
}
